# Copy this template to .env and fill it privately. Do not commit .env.
# The client expects an OpenAI-compatible chat-completions service.
LLM_API_KEY=
LLM_BASE_URL=
GENURBAN_MODELS=

# Optional: a comma-separated subset of NYC, Las Vegas, San Francisco, Minneapolis.
GENURBAN_CITIES=
GENURBAN_WORKSPACE=private_workspace
GENURBAN_PLOTS=0

# Optional: only needed when fetching ACS rather than supplying a prepared cache.
# Supply the ACS dataset root ending in the desired year/acs/acs5 path.
CENSUS_API_KEY=
CENSUS_API_BASE_URL=
